# VinylVault — Переменные окружения

# База данных
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vinyl_store
DB_PORT=3306

# JWT
SECRET_KEY=vinyl-vault-secret-key-change-in-production
JWT_EXPIRATION_HOURS=72

# Приложение
FLASK_ENV=development
DEBUG=True

# Пагинация
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=50

# Доставка
FREE_SHIPPING_THRESHOLD=5000
STANDARD_SHIPPING_COST=300

# Платежи
PAYMENT_SIMULATION_ENABLED=true
